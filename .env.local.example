# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# --- Local development (docker-compose neo4j) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localdevpassword
NEO4J_DATABASE=neo4j

# --- CognoDB Cloud (use these for the real deployment / submission) ---
# NEO4J_URI=bolt+s://<instance-id>.databases.cognodb.cloud
# NEO4J_USER=cognodb
# NEO4J_PASSWORD=<the password shown once when you created the instance>
# NEO4J_DATABASE=neo4j
